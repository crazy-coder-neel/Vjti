# ==============================================================================
# SpoonSense Frontend Environment Variables
# ==============================================================================

# 1. FastAPI Backend API Base URL
VITE_API_URL=http://localhost:8000

# 2. Supabase Client Credentials (Must match your backend Supabase project)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
