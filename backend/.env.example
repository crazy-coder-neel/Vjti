# ==============================================================================
# SpoonSense Backend Environment Variables
# ==============================================================================

# 1. Google Gemini API (Required for Task Shrinker, Voice Transcription & Cognitive Scheduler)
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Database & Auth (Required for user profile & cloud persistence)
# Find in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
